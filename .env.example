# Copy to .env and set a password before running Docker Compose.
# .env is ignored by Git. Never store real credentials in this example.
POSTGRES_PASSWORD=
POSTGRES_DB=lilboard
POSTGRES_USER=lilboard

# Build this tag with `docker compose up -d --build`, or specify a published
# image/digest and run `docker compose up -d --no-build --pull always`.
BOARD_IMAGE=lilboard-board:local

# App exposure on the Docker host. PostgreSQL has no published host port.
BOARD_BIND_ADDRESS=127.0.0.1
BOARD_PORT=8080
